{
	"name": "limkenion-core",
	"version": "1.0.0",
	"description": "最小 agent 内核：主循环与系统工具",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"limkenion-ai": "^1.0.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"tools"
	],
	"author": "IamCanincan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IamCanincan/Limkenion.git",
		"directory": "packages/core"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
