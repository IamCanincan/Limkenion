{
  "name": "limkenion-web",
  "description": "Limkenion web UI: Vite + React chat client served by a local server, learned from deepseek-harness's web client architecture",
  "version": "0.5.0",
  "type": "module",
  "bin": {
    "limkenion-web": "bin/limkenion-web.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "typecheck:web": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node e2e/e2e.mjs",
    "test:ui": "vitest run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
