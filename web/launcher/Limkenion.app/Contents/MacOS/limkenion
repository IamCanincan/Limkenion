#!/bin/bash
# Limkenion macOS 启动器
# Finder 双击 .app 时直接执行本文件，不会打开 Terminal。
# 路径推算：本文件位于 Limkenion.app/Contents/MacOS/，上三级即 launcher 目录（.app 的父目录）。
SCRIPT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

# 优先用包内 Node（随 .app 一起分发），缺失再回退系统 node
ARCH="$(uname -m)"
if [ "$ARCH" = "arm64" ]; then NSUB="darwin-arm64"; else NSUB="darwin-x64"; fi
BUNDLED="$SCRIPT_DIR/Limkenion.app/Contents/Resources/node/$NSUB/node"
if [ -x "$BUNDLED" ]; then
  node_bin="$BUNDLED"
else
  node_bin="$(command -v node 2>/dev/null)"
fi

if [ -z "$node_bin" ]; then
  osascript -e 'display dialog "未找到可用的 Node.js（包内 node 缺失且系统未安装）。

Limkenion 已内置 Node.js；若被误删请重新解压发布包，或到 https://nodejs.org 安装 Node.js（≥20.11）。" buttons {"好"} default button "好" with icon caution' 2>/dev/null
  exit 1
fi

ver="$("$node_bin" -v 2>/dev/null)"
major="$(printf '%s' "$ver" | sed -E 's/^v?([0-9]+)\..*/\1/')"
minor="$(printf '%s' "$ver" | sed -E 's/^v?[0-9]+\.([0-9]+).*/\1/')"
if [ "${major:-0}" -lt 20 ] || { [ "${major:-0}" -eq 20 ] && [ "${minor:-0}" -lt 11 ]; }; then
  osascript -e "display dialog \"Node.js 版本过低（当前 ${ver}）。

请重新解压发布包使用内置新版 Node，或升级系统 Node.js ≥20.11。
下载地址：https://nodejs.org\" buttons {\"好\"} default button \"好\" with icon caution" 2>/dev/null
  exit 1
fi

exec "$node_bin" "$SCRIPT_DIR/launcher.mjs"
